SELECT Doctor, Professor, Singer, Actor
FROM (
    SELECT Name, Occupation, 
           ROW_NUMBER() OVER(PARTITION BY Occupation ORDER BY Name) as rn
    FROM OCCUPATIONS
)
PIVOT (
    MAX(Name)
    FOR Occupation IN (
        'Doctor' AS Doctor, 
        'Professor' AS Professor, 
        'Singer' AS Singer, 
        'Actor' AS Actor
    )
)
ORDER BY rn;

