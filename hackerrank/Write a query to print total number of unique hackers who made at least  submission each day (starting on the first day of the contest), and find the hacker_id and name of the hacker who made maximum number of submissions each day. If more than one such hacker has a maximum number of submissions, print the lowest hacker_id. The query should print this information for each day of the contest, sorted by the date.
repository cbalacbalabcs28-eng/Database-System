SELECT 
    submission_date,
    /* Subquery 1: Count unique hackers who submitted every day up to the current date */
    (SELECT COUNT(DISTINCT hacker_id)
     FROM Submissions s2
     WHERE s2.submission_date = s1.submission_date
     AND (SELECT COUNT(DISTINCT s3.submission_date)
          FROM Submissions s3
          WHERE s3.hacker_id = s2.hacker_id
          AND s3.submission_date < s1.submission_date) = s1.submission_date - TO_DATE('2016-03-01', 'YYYY-MM-DD')),
    /* Subquery 2: Find the ID of the hacker with max submissions on this day */
    (SELECT hacker_id FROM (
        SELECT hacker_id, submission_date,
               ROW_NUMBER() OVER(PARTITION BY submission_date ORDER BY COUNT(*) DESC, hacker_id ASC) as rnk
        FROM Submissions
        GROUP BY submission_date, hacker_id
    ) s4 WHERE s4.submission_date = s1.submission_date AND rnk = 1),
    /* Subquery 3: Find the Name of the hacker from Subquery 2 */
    (SELECT name FROM Hackers WHERE hacker_id = (
        SELECT hacker_id FROM (
            SELECT hacker_id, submission_date,
                   ROW_NUMBER() OVER(PARTITION BY submission_date ORDER BY COUNT(*) DESC, hacker_id ASC) as rnk
            FROM Submissions
            GROUP BY submission_date, hacker_id
        ) s5 WHERE s5.submission_date = s1.submission_date AND rnk = 1))
FROM (SELECT DISTINCT submission_date FROM Submissions) s1
ORDER BY submission_date;


